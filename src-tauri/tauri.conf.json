{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:bundle",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "GBFR Logs Kaguya Edition",
    "version": "1.8.7"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "clipboard": {
        "writeText": true
      },
      "shell": {
        "all": false,
        "open": true
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "maximize": true,
        "minimize": true,
        "unmaximize": true,
        "unminimize": true,
        "startDragging": true
      },
      "fs": {
        "readFile": true,
        "scope": ["$RESOURCE/*", "$RESOURCE/lang/*", "$RESOURCE/lang/*/*", "$RESOURCE/assets/*", "$RESOURCE/assets/*/*"]
      },
      "path": {
        "all": true
      }
    },
    "windows": [
      {
        "title": "GBFR Logs Kaguya Edition - Logs",
        "label": "logs",
        "url": "/logs",
        "fullscreen": false,
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "closable": true,
        "decorations": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": ["msi"],
      "identifier": "com.chickenseller.gbfr-logs-awa",
      "longDescription": "GBFR Logs Kaguya Edition - community-maintained DPS meter for Granblue Fantasy: Relink",
      "shortDescription": "GBFR Logs Kaguya Edition",
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
      "resources": ["hook.dll", "assets/*", "lang/*"],
      "windows": {
        "webviewInstallMode": {
          "type": "embedBootstrapper"
        }
      }
    },
    "systemTray": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    },
    "updater": {
      "active": false,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDQjZEMTgxOEY4OTIwNDcKUldSSElJbVBnZEcyM1BSUklxWWRsWStXYnVsWU1mODY3YzZCWCtTZzJrUGJsZHpNY1h1S3hhc2cK",
      "endpoints": [
        "https://raw.githubusercontent.com/ChickenSeller/gbfr-logs/codex/game-2.0.2-compat/update.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
